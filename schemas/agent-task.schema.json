{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ZyntroAI/fastapi-python-boilerplate/schemas/agent-task.schema.json",
  "title": "AgentTask",
  "description": "Structured task for compute instance management",
  "type": "object",
  "required": ["task_id", "action"],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this task"
    },
    "action": {
      "type": "string",
      "enum": [
        "list_instances",
        "start_instance",
        "stop_instance",
        "reboot_instance"
      ],
      "description": "Operation to perform"
    },
    "instance_id": {
      "type": ["string", "null"],
      "description": "Target instance ID — required for start/stop/reboot"
    }
  },
  "additionalProperties": false
}
